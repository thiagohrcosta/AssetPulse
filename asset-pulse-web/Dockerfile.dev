# Development image: installs deps into the image (kept warm in the
# asset_pulse_web_node_modules named volume) and is meant to be used
# together with a source-code bind mount (see the root docker-compose.yml)
# so changes on the host are picked up without rebuilding.
#
# `next dev` binds 0.0.0.0 by default (Next.js 16), so no extra -H flag is
# needed to make it reachable from outside the container.
ARG NODE_VERSION=24
FROM docker.io/library/node:${NODE_VERSION}-alpine

WORKDIR /app

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

COPY . .

EXPOSE 3000

CMD ["yarn", "dev"]
