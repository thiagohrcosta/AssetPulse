# Copy this file to `.env` and adjust as needed.
# docker compose automatically reads a `.env` file placed next to docker-compose.yml.

# --- Database (asset-pulse-api) ---
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# --- API (asset-pulse-api) ---
API_PORT=3000
# Only required if ./asset-pulse-api/config/master.key doesn't exist on disk
# (the dev setup mounts the real file automatically via the source volume).
# RAILS_MASTER_KEY=

# --- Web (asset-pulse-web) — used later ---
# WEB_PORT=3001
