# Copy this file to `.env` and adjust as needed.
# docker compose automatically reads a `.env` file placed next to docker-compose.yml.

# --- Database (asset-pulse-api) ---
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# --- API (asset-pulse-api) ---
API_PORT=3000
# Only required if ./asset-pulse-api/config/master.key doesn't exist on disk
# (the dev setup mounts the real file automatically via the source volume).
# RAILS_MASTER_KEY=

# Cloudinary account URL, used to store company logo uploads.
# Find it at https://console.cloudinary.com/ -> Dashboard -> "API Environment variable".
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Comma-separated browser origins allowed to call the API (CORS).
# CORS_ORIGINS=http://localhost:3001

# --- Billing (asset-pulse-api / Stripe) ---
# Secret key used server-side to call the Stripe API.
# Find it at https://dashboard.stripe.com/apikeys (use a restricted or test key while developing).
STRIPE_SECRET_KEY=
# Signing secret for the /api/v1/stripe/webhooks endpoint.
# Get it from the Stripe Dashboard webhook config, or from `stripe listen --print-secret` in dev.
STRIPE_WEBHOOK_SECRET=
# Where Stripe Checkout redirects after a subscription is purchased/abandoned.
# Point these at the web app's plan-selection screen.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3001/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3001/billing/cancel

# --- Web (asset-pulse-web) — used later ---
# WEB_PORT=3001
